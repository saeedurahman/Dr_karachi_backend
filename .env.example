# ─── Application ───────────────────────────────────────────────
APP_NAME="Karachi Lab, Pharmacy & Clinics API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=development   # development | staging | production

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/karachi_db
SYNC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/karachi_db

# ─── JWT ───────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── File Storage ──────────────────────────────────────────────
# Options: local | s3
STORAGE_BACKEND=s3

# Cloudflare R2 (S3-compatible)
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_BUCKET_NAME=karachi-clinic-uploads
S3_PUBLIC_URL=https://cdn.yourdomain.com   # Custom domain / public URL prefix

# Product images (separate PUBLIC bucket, same R2 account/endpoint as S3_ENDPOINT_URL above)
PRODUCT_IMAGES_BUCKET_NAME=karachi-product-images
PRODUCT_IMAGES_PUBLIC_URL=https://product-images.yourdomain.com
PRODUCT_IMAGES_ACCESS_KEY_ID=your-r2-access-key-id
PRODUCT_IMAGES_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Local storage fallback
LOCAL_UPLOAD_DIR=./uploads

# ─── Business Rules ────────────────────────────────────────────
PLATFORM_FEE_RATE=0.02        # 2% platform fee on orders
DELIVERY_FEE=150              # PKR flat delivery charge
APPOINTMENT_SLOT_DURATION=30  # minutes

# ─── Allowed Origins (CORS) ────────────────────────────────────
# Comma-separated list
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
